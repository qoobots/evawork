{
  "name": "@evawork/mcp-bundle",
  "version": "0.1.0",
  "private": true,
  "description": "随应用分发的 MCP 服务聚合包：把 npx 类服务预先装好，启动时直接跑本地副本，免去 npm 下载。每个内置服务一个薄包（apps/mcp/<name>），依赖由各自声明，这里只做聚合——加/删一个内置服务改这里一行即可。",
  "dependencies": {
    "@evawork/mcp-chrome-devtools": "workspace:*",
    "@evawork/mcp-context7": "workspace:*",
    "@evawork/mcp-everything": "workspace:*",
    "@evawork/mcp-filesystem": "workspace:*",
    "@evawork/mcp-memory": "workspace:*",
    "@evawork/mcp-playwright": "workspace:*",
    "@evawork/mcp-sequential-thinking": "workspace:*"
  }
}
